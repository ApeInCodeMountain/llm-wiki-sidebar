{
  "name": "llm-wiki-sidebar",
  "version": "2.0.0",
  "description": "LLM Wiki workbench for the DeepSeek Harness sidebar: browse and lint one or several Karpathy-style interlinked markdown wikis per workspace, render wiki pages with clickable [[wikilinks]], relative .md links and backlinks, and ship the llm-wiki agent skill.",
  "type": "module",
  "license": "MIT",
  "author": "ApeInCodeMountain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ApeInCodeMountain/llm-wiki-sidebar.git"
  },
  "homepage": "https://github.com/ApeInCodeMountain/llm-wiki-sidebar#readme",
  "bugs": {
    "url": "https://github.com/ApeInCodeMountain/llm-wiki-sidebar/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-sidebar",
    "llm-wiki",
    "knowledge-base",
    "markdown",
    "wikilinks"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "skills",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --check lib/client.js && node --check lib/index.js && node test/impl.test.mjs && node test/host.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  }
}
